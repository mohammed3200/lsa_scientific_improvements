# Python cache
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
dist/
build/

# Test & IDE caches
.pytest_cache/
.mypy_cache/
.vscode/
.idea/
*.swp
*.swo
*~

# Generated results (auto-created by pipeline)
results/raw_data/*
results/figures/*
results/interactive/*
results/reports/*
results/article_figures/*
results/*.png
results/*.json
results/*.csv
results/*.md
results/*.txt
lsa_project/results/*.png
lsa_project/results/*.json
lsa_project/results/*.csv

# Legacy generated files
*.html
*.pdf
COMPARISON_REPORT.md
GITHUB_RELEASE.md

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Virtual environments (if created inside project)
venv/
env/
ENV/
lsa/
lsa_improvements/

# Keep directory structure
!results/raw_data/.gitkeep
!results/figures/.gitkeep
!results/interactive/.gitkeep
!results/reports/.gitkeep
!results/article_figures/.gitkeep
